# =============================================================================
#  Configuration for port_idb.bat and ai_diff.bat
#
#  Copy this file to ".env" next to the scripts and fill in at least IDA_DIR:
#
#      copy .env.example .env
#
#  Format: KEY=VALUE, one per line. Lines starting with # are comments. A key
#  left empty counts as "not configured" and the script's own default applies,
#  which is why every optional key below is commented out. Do not indent a key
#  and do not leave trailing spaces after a value: both end up inside the name
#  or the value.
#
#  A variable that is already set in the environment wins over this file, so a
#  one-off override needs no edit here (mind the missing space before &&, cmd
#  would otherwise put it inside the value):
#
#      set PORT_FOLDERS=0&& port_idb.bat old.i64 new.i64
# =============================================================================

# -- Required ----------------------------------------------------------------

# Folder that contains idat.exe (and idat64.exe on IDA < 9.0).
# Example: D:\ida-9.4\ida-9.4
IDA_DIR=


# -- Paths -------------------------------------------------------------------

# The diaphora checkout. Defaults to the folder holding these scripts, which is
# almost always right. It must NOT contain spaces: IDA splits the argument of
# its -S switch on whitespace, so a space would break the scripts it runs.
#DIAPHORA_DIR=

# Python 3 interpreter for the diffing and exporting steps (no IDA needed
# there). Default: python
#PYTHON_EXE=


# -- port_idb.bat ------------------------------------------------------------

# Port the Functions window folder layout of the old database as well.
# Set to 0 to skip that step. Default: 1
#PORT_FOLDERS=

# Minimum similarity ratio a match needs before Diaphora imports it.
# Read by Diaphora itself, not by the scripts. Default: 0.5
#DIAPHORA_MINIMUM_IMPORT_RATIO=


# -- ai_diff.bat -------------------------------------------------------------

# Cap on the number of per-function .diff files, lowest ratio first.
# Default: 2000
#AI_DIFF_MAX_DIFFS=

# Context lines around each change in those .diff files. Default: 3
#AI_DIFF_CONTEXT=

# Drop matches below this ratio from the export entirely. Default: 0.0
#AI_DIFF_MIN_RATIO=

# Set to 1 to export the databases again even when db\*.sqlite already exists.
# Exporting is the slow step, so an existing export is otherwise reused as is.
# Default: unset
#AI_DIFF_FORCE=


# -- Both scripts ------------------------------------------------------------

# Run the Hex-Rays decompiler during the export. Turning it off (0) makes the
# export far faster but leaves the diffs with assembly instead of pseudo-code,
# and costs Diaphora its pseudo-code based heuristics. Default: 1
#USE_DECOMPILER=

# Any other DIAPHORA_* variable Diaphora reads from the environment can be put
# here too: the scripts pass their whole environment down to IDA and to
# diaphora.py. See CBinDiff.get_value_for() in diaphora.py for the full list.
