# =============================================================================
#  Configuration for diaphora_run.bat
#
#  Copy this file to ".env" next to the script and fill in at least IDA_DIR:
#
#      copy .env.example .env
#
#  Format: KEY=VALUE, one per line. Lines starting with # are comments. A key
#  left empty counts as "not configured" and the script's own default applies,
#  which is why every optional key below is commented out. Do not indent a key
#  and do not leave trailing spaces after a value: both end up inside the name
#  or the value.
#
#  A variable that is already set in the environment wins over this file, so a
#  one-off override needs no edit here (mind the missing space before &&, cmd
#  would otherwise put it inside the value):
#
#      set PORT_FOLDERS=0&& diaphora_run.bat old.i64 new.i64
# =============================================================================

# -- Required ----------------------------------------------------------------

# Folder that contains idat.exe (and idat64.exe on IDA < 9.0).
# Example: D:\ida-9.4\ida-9.4
IDA_DIR=


# Copy the old database into the scratch directory and read that instead of
# the original, which is then never opened at all. Opening a database is not
# free: IDA rewrites the .i64 container every time it closes one, and the
# exporting step decompiles every function, which Hex-Rays caches inside the
# database -- 842 KB grew to 1.6 MB on the first export of a small sample.
# The old database usually holds analysis that cannot be reproduced, so this
# is on by default. Set to 0, or pass --no-protect-old, to read it directly.
# Default: 1
#PROTECT_OLD=


# -- Paths -------------------------------------------------------------------

# The diaphora checkout. Defaults to the folder holding the script, which is
# almost always right. It must NOT contain spaces: IDA splits the argument of
# its -S switch on whitespace, so a space would break the scripts it runs.
#DIAPHORA_DIR=

# Python 3 interpreter for the diffing and exporting steps (no IDA needed
# there). Default: python
#PYTHON_EXE=


# -- Porting into the new database (--port) ----------------------------------

# Port the Functions window folder layout of the old database as well.
# Set to 0 to skip that step, same as passing --no-folders. Default: 1
#PORT_FOLDERS=

# Port the Hex-Rays local variable names and types, function arguments
# included. This is what keeps an unchanged function from diffing as "status"
# against "v4". Applying them means decompiling the functions that have any,
# so it costs time on a big database. Set to 0 to skip, same as passing
# --no-lvars. Default: 1
#PORT_LVARS=

# Port the stack frame member names and types. These are a different thing
# from the local variables above: they live in the function's frame type and
# are what the disassembly shows, so the old database's
#     mov [rsp+58h+flag], 0
# reads as
#     mov [rsp+58h+var_40], 0
# until they are ported. Nothing in Diaphora carries them over. On a real pair
# of builds they were the largest single difference between the two databases,
# 692 of the 1157 functions whose disassembly did not match.
#
# This does not change the diff -- the AI export masks frame member names on
# both sides before comparing -- it makes the new database readable, which is
# the point of porting in the first place. Reading and writing them is a type
# library operation, so it decompiles nothing and costs very little.
# Set to 0 to skip, same as passing --no-frames. Default: 1
#PORT_FRAMES=


# Create in the new database the functions that only exist in the old one,
# before the new one is exported.
#
# Diaphora can only port what it matched, and it can only match a function
# that exists on both sides. A function auto-analysis never found in the new
# database -- a hypercall handler reached only through a dispatch table, say --
# is invisible to the whole pipeline, so its name, prototype, types, local
# variables, stack frame and folder never move across. Diffing two databases
# of one binary, 218 of the old side's named functions had no function at all
# in the new one.
#
# This is the one porting step that writes to the new database before it is
# exported, which is why it runs as its own step; the backup is taken before
# it. Addresses that fall inside, or overlap, a function the new database
# already has are reported rather than forced, since moving or splitting an
# existing function is a judgement call rather than an omission.
# Set to 0 to skip, same as passing --no-create-funcs. Default: 1
#CREATE_FUNCS=

# How to port struct/enum/union/typedef definitions and function prototypes.
# They are transferred in IDA's own serialized form, which is exact: printing
# them as C and parsing them back lost 155 of 2181 types on a real pair of
# builds, and truncated every struct that had one of those as a member.
#   all      replace a type the new database already has. The old database is
#            the source of truth. (default)
#   missing  keep what the new database has, only fill in what is absent
#   0        leave the types to Diaphora's own C text path
# Same as passing --types all / --types missing / --no-types.
#PORT_TYPES=

# Minimum similarity ratio a match needs before Diaphora imports it.
# Read by Diaphora itself, not by the scripts. Default: 0.5
#DIAPHORA_MINIMUM_IMPORT_RATIO=


# -- AI export (--ai) --------------------------------------------------------

# Cap on the number of per-function .diff files, lowest ratio first.
# Default: 2000
#AI_DIFF_MAX_DIFFS=

# Context lines around each change in those .diff files. Default: 3
#AI_DIFF_CONTEXT=

# Drop matches below this ratio from the export entirely. Default: 0.0
#AI_DIFF_MIN_RATIO=

# Set to 1 to export the databases again even when db\*.sqlite already exists,
# same as passing --force. Exporting is the slow step, so an existing export is
# otherwise reused as is. Note that the new database is always exported afresh
# when porting, since a cached export may be one a previous import rewrote.
# Default: unset
#AI_DIFF_FORCE=


# -- Both halves -------------------------------------------------------------

# Run the Hex-Rays decompiler during the export. Turning it off (0) makes the
# export far faster but leaves the diffs with assembly instead of pseudo-code,
# and costs Diaphora its pseudo-code based heuristics. Default: 1
#USE_DECOMPILER=

# Any other DIAPHORA_* variable Diaphora reads from the environment can be put
# here too: the script passes its whole environment down to IDA and to
# diaphora.py. See CBinDiff.get_value_for() in diaphora.py for the full list.
